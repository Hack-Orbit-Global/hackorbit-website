{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/profile/:id",           "destination": "/api/profile/[id]" },
    { "source": "/verify-result/:id",     "destination": "/api/verify/[id]" },
    { "source": "/api/certificates/verify", "destination": "/api/verify/index" }
  ],
  "headers": [
    {
      "source": "/frontend/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/frontend/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/frontend/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/github-reconcile", "schedule": "0 3 * * *" }
  ]
}
